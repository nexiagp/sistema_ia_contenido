OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
PORT=8787

# Opcional: webhook propio para publicar en redes sociales.
# Si no se define, el modo automatico dejara los posts como "listos".
SOCIAL_WEBHOOK_URL=

# WordPress REST: usa un usuario técnico y una contraseña de aplicación.
# Nunca expongas estos valores al navegador ni los subas al repositorio.
WORDPRESS_BASE_URL=https://nexiagp.com
WORDPRESS_USERNAME=
WORDPRESS_APPLICATION_PASSWORD=
# Opcionales: reutiliza IDs existentes de WordPress; si se dejan vacíos,
# WordPress aplica su autor/categoría por defecto.
WORDPRESS_DEFAULT_CATEGORY_ID=
WORDPRESS_AUTHOR_ID=
# En Vercel, los envíos a WordPress se bloquean si la app sigue pública.
# Activa la autenticación antes de habilitar estas variables en producción.

# Supabase managed production. Never put the service key in browser code.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STATE_BACKEND=0
NEXIAGP_AUTH_REQUIRED=0
CRON_SECRET=
